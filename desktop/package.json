{
  "name": "operator-takip-pc",
  "version": "1.6.0",
  "description": "Operatör Takip Windows masaüstü uygulaması",
  "main": "main.js",
  "author": "Oguzhan Cevik",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node check-syntax.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.oguzhan.operatorpc",
    "productName": "Operator Takip PC",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", "v15-extra.js", "v16-sync.js"],
    "win": {
      "target": [{"target":"portable","arch":["x64"]}],
      "artifactName": "Operator-Takip-PC-${version}.exe"
    }
  }
}
